<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/tv_banner"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <!-- android.intent.category.LEANBACK_LAUNCHER is what makes Android TV's own home
                 screen list this app at all — without it a sideloaded APK simply never shows up
                 there, even though everything else about it (this same activity, the same web
                 UI) already runs fine on a TV. Kept on the very same activity/intent-filter as
                 the phone launcher entry rather than a separate alias: there is only one UI to
                 launch into, it just adapts at runtime (see body[data-platform="tv"] in
                 style.css and detectTvPlatform() in main.js). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Grants "notification access", which also unlocks reading Deezer's active
             MediaSession (title/artist/art/play state) and sending it transport controls. -->
        <service
            android:name=".NowPlayingListenerService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Analyzes Deezer's own audio output (AudioPlaybackCapture, API 29+) to drive the
             real-time visualizer. Started only after the user grants the MediaProjection
             consent requested by DeezerMediaPlugin. -->
        <service
            android:name=".AudioCaptureService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Draws the edge-glow overlay (see OverlayEdgeGlowService) on top of whichever app is
             in front. "specialUse" is the closest of Android's declared foreground-service
             types to what this actually is — a decorative visual layered over another app while
             media plays — none of the more specific types (mediaPlayback, mediaProjection…) fit
             a service that neither plays nor captures anything itself. "microphone" is declared
             alongside it because this service also runs its own MicCaptureThread when "Micro" is
             the chosen audio source (see AudioSourcePreference): without declaring that type,
             Android silently cuts background microphone access after a few seconds regardless of
             the RECORD_AUDIO grant, which is exactly why the glow used to go static shortly after
             leaving Vizuzik in "Micro" mode. -->
        <service
            android:name=".OverlayEdgeGlowService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse|microphone">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="overlay_visual_effects" />
        </service>
    </application>

    <!-- Declared android:required="false" purely so the Play Store / package installer never
         filters this APK out on a device that has neither (Android TV boxes: no touchscreen,
         and only some declare the leanback feature themselves). Nothing here is required at
         runtime — the app already works without either, this only affects who can install it. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- The "display over other apps" special permission (granted per-app in system Settings,
         not at install time): required for OverlayEdgeGlowService's TYPE_APPLICATION_OVERLAY
         window to draw on top of Deezer/Spotify. See requestOverlayPermission() in
         DeezerMediaPlugin.java for the settings screen this opens. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Micro mode: a plain AudioRecord on the phone's own mic (see MicCaptureThread.java),
         deliberately not the WebView's getUserMedia() — that path is WebRTC-shaped under the
         hood and pulls Android's audio mode into its "in a call" state for as long as it's open,
         which over Bluetooth is what makes a connected car head unit switch into its own
         phone-call UI. DeezerMediaPlugin requests this at runtime itself (the "microphone"
         permission alias), same as any other dangerous permission. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Without this, PackageManager#getApplicationInfo(...) / getLaunchIntentForPackage(...)
         can fail on Android 11+ package-visibility restrictions, breaking both the UID lookup
         AudioCaptureService uses to scope playback capture to the tracked app, and the install
         detection / auto-launch DeezerMediaPlugin does for each app it knows about. -->
    <queries>
        <package android:name="deezer.android.app" />
        <package android:name="com.spotify.music" />
    </queries>
</manifest>

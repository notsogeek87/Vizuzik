<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Connexion Deezer (OAuth + API : mes albums/playlists) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Bibliothèque musicale locale -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Lecture en arrière-plan -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Égaliseur / effets audio réels (android.media.audiofx) -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Visualiseur de spectre (android.media.audiofx.Visualizer), demandée
         uniquement à l'ouverture de l'écran VIS -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:name=".VizuzikApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Vizuzik">

        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Vizuzik.Launch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".player.PlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Service vide : ne lit aucune notification. Il n'existe que pour
             débloquer MediaSessionManager.getActiveSessions, qui permet de lire
             et piloter la session média d'une autre app (sonde Deezer).
             exported="true" car un service porteur d'un intent-filter l'était
             par défaut avant l'API 31 : c'est la configuration historiquement
             fonctionnelle pour un listener de notifications. Le bind reste
             verrouillé par BIND_NOTIFICATION_LISTENER_SERVICE, de niveau
             signature, que seul le système détient. -->
        <service
            android:name=".diagnostics.VizuzikNotificationListener"
            android:label="@string/app_name"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>
</manifest>
